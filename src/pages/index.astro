---
import Main from '../layouts/main.astro';
import Hero from '../images/right-img.png';
import logo from '../images/logo-2026.png';
import fos from '../images/fossee-logo.png';
import iit from '../images/IITB-logo.png';
// import regi from '../images/btn-01-a.png';
---

<Main>
  <div class="lg:hidden sm:block rounded-t-lg mx-1 px-1" style="background:#ddea9afff;">
    <!-- Logos Navigation -->
    <div class="flex flex-row align-items-center justify-center bottom-8" style="background-color:#ddea9afff">
      <div class="flex items-start justify-start float-start w-1/2">
        <a href="https://www.iitb.ac.in/" target="_blank">
          <img src={iit.src} alt="iitb" decoding="async" style="width: 100px;">
        </a>
      </div>
      <div class="flex justify-end items-end float-end w-1/2">
        <a href="https://fossee.in" target="_blank">
          <img class="float-end" src={fos.src} alt="fossee" decoding="async" style="width: 100px;">
        </a>
      </div>
    </div>

    <div class="grid my-auto grid-rows-1 sm:grid-rows-1">
      <div class="row-span-1">
        <div class="pt-5 flex items-center justify-center">
          <img src={logo.src} alt="regi" decoding="async" />
        </div>
      </div>
    </div>
         

    
    <!-- Call To Action Buttons -->
    <div class="mt-6 flex w-full flex-col items-center justify-center gap-3 px-4 sm:flex-row sm:gap-4">
      <!-- Register Button -->
      <a
        href="/register"
        class="inline-flex w-full max-w-xs items-center justify-center rounded-md bg-[#38a169] px-6 py-3 text-base font-bold text-white shadow-md transition-all duration-200 hover:scale-105 hover:bg-[#2f855a] active:scale-95 sm:w-auto sm:px-8 sm:py-2.5 sm:text-lg lg:text-xl"
      >
        Register
      </a>

      <!-- FAQ Button -->
      <a
        href="https://docs.google.com/document/u/0/d/e/2PACX-1vR66m-aiPtDOeEOruyiIeKlf3198cuNr6tBpHwqjlouzN5wAQmn6LN8CzD1A-5cDbE4IFrwfkrywsIa/pub?pli=1"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full max-w-xs items-center justify-center rounded-md bg-[#38a169] px-6 py-3 text-base font-bold text-white shadow-md transition-all duration-200 hover:scale-105 hover:bg-[#2f855a] active:scale-95 sm:w-auto sm:px-8 sm:py-2.5 sm:text-lg lg:text-xl"
      >
        FAQ
      </a>
    </div>

    <div class="row-span-1 bg-red-500 mt-4"> 
      <div class="dates items-center" style="color:#0fe425"> 
        <!-- Optional date notice content can go here -->
      </div>
    </div>
  </div>

  <style>
    .custom-register-btn {
      display: inline-block;
      border-radius: 0.375rem;
      background-color: #38a169;
      padding: 0.625rem 2rem;
      font-size: 1.25rem;
      font-weight: 700;
      color: #ffffff;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      transition: all 0.2s ease-in-out;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    @media (hover: hover) {
      .custom-register-btn:hover {
        background-color: #2f855a;
        transform: scale(1.05);
      }
    }

    .custom-register-btn:active {
      background-color: #2f855a;
      transform: scale(0.95);
    }
  </style>

  <!-- Hero Section -->
  <section id="hero" class="relative w-full">
    <img 
      class="w-full object-cover p-2" 
      src={Hero.src} 
      alt="WELCOME TO SYNFIG STUDIO HACKATHON" 
      decoding="async" 
    />

    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2
             w-[85%] max-w-[700px]
             bg-[#333333]
             text-white
             rounded-2xl
             px-6 py-4
             justify-center content-center
             text-center
             shadow-lg z-10"
    >
      <p class="text-lg md:text-2xl lg:text-3xl font-medium leading-tight">
        Bring storytelling imagination to life with
        <span class="font-normal">
          Synfig Studio, Blender,
        </span>
        and the spark of AI.
      </p>
    </div>
  </section>
</Main>
---
import Main from '../layouts/main.astro';

const workshops = [
  {
    title: "1. Inkscape Workshop",
    topic: "Creating and Modifying AI-Generated Images",
    about: "Learn to create, edit, and refine AI-generated images using vector graphics tools in Inkscape.",
    dateandtime: "31 Oct 2026. 11:00 AM to 1:00 PM",
    youtubelink: "https://www.youtube.com/live/mUW4z1RW0L4"
  },
  {
    title: "2. GIMP Workshop",
    topic: "Creating and Modifying AI-Generated Images",
    dateandtime:"07 Nov 2026. 11:00 AM to 1:00 PM",
    about: "Learn to edit, enhance, and refine AI-generated images using GIMP.",
    Note:" Recorded session will be available very soon.",
  },
  {
    title: "3. Synfig Studio Workshop",
    topic: "Creating 2D Animations Using AI-Generated Images as References",
    dateandtime: "13 Nov 2026. 11:00 AM to 1:00 PM",
    about: "Learn to use AI-generated images as references for creating and animating 2D characters, objects, and scenes in Synfig Studio.",
    googlemeetinglink: "https://meet.google.com/ffw-oxou-btp",
    Youtubelivelink: " https://www.youtube.com/live/eCqf8PqkPm8?si=k8LJzOw8Gluv5z5t"
  },
  {
    title: "4. Blender Workshop - 3D Animation",
    topic: "Creating 3D Animations Using AI-Generated Images as References",
    duration: "2 hours",
    about: "Explore 3D modelling, scene creation, and animation using Blender and AI-generated visual references."
  },
  {
    title: "5. Blender Workshop - Video Editing",
    topic: "Combining Animation Clips, Audio, and Background Music",
    duration: "2 hours",
    about: "Learn to combine animation clips, synchronize audio, add background music, and export a final video using Blender's Video Sequence Editor."
  },
  {
    title: "6. OpenShot Workshop - Video Editing",
    topic: "Editing and Combining Animation Clips",
    duration: "2 hours",
    about: "Learn to arrange animation clips, add audio and background music, and export the final animation video using OpenShot Video Editor."
  },
  {
    title: "7. Webinar - Animation Project Submission",
    topic: "Preparing, Packaging, and Submitting Animation Projects",
    duration: "1 hour",
    about: "Learn to organise project files and assets, create a ZIP package, submit it through the official ANIMATE 2026 submission form, and verify that all required files are included and accessible."
  }
];
---

<Main>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-4xl px-6">

      <!-- Registration Button -->
      <div class="mt-6 mb-5 flex justify-center">
        <a
          href="https://docs.google.com/forms/d/1ctxQZiO_yyxO06pgiyMw7IyL-ydzlpM2KrLoIR3lHpU/viewform?edit_requested=true"
          target="_blank"
          rel="noopener noreferrer"
          class="custom-register-btn"
        >
          Register for Workshops
        </a>
      </div>

      <!-- Header Section -->
      <div class="mb-10 text-center">
        <h1 class="mb-3 text-3xl font-bold text-[#800000] md:text-4xl">
          ANIMATE 2026 - Workshops & Webinar
        </h1>

        <p class="mb-4 text-base text-gray-700 md:text-lg">
          Join our workshops and webinar to learn how to create, animate,
          edit, and submit animation projects using open-source software.
        </p>

        <div class="flex flex-col justify-center gap-2 rounded-lg bg-[#dde9af] px-6 py-3 text-lg font-medium text-gray-800 shadow-sm sm:flex-row sm:gap-6">
          <p>
            <strong>Tentative Schedule:</strong> 24 October - 25 November 2026
          </p>

          <p>
            <strong>Target Audience:</strong> ANIMATE 2026 participants
          </p>
        </div>
      </div>

      <!-- Workshops Accordion -->
      <div class="space-y-4">
        {workshops.map((item, index) => (
          <details class="group overflow-hidden rounded-xl border border-green-300 bg-white shadow-sm">

            <summary class="flex cursor-pointer select-none items-center justify-between p-5 text-lg font-bold text-[#800000] hover:bg-gray-50">
              <span>{item.title}</span>

              <svg
                class="h-5 w-5 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>

            <div class="space-y-3 border-t border-gray-100 bg-gray-50/50 px-5 pb-5 pt-4 text-gray-700">

              <p><strong>Topic:</strong> {item.topic}</p>

            {item.dateandtime && (
                  <p><strong>Date & Time:</strong> {item.dateandtime}</p>
              )}

              {index <= 1 && item.duration && (
                <p><strong>Duration:</strong> {item.duration}</p>
              )}

              <p><strong>About:</strong> {item.about}</p>
        {item.Note && (
             <div class="mt-4 rounded-lg border border-green-300 bg-[#dde9af] p-4">
           <p class="text-base font-medium text-yellow-800">
            <strong>Note:</strong> {item.Note}
           </p>
         </div>
         
        )}
              {item.youtubelink && (
                <div class="pt-3">
                  <a
                    href={item.youtubelink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block rounded-lg bg-[#800000] px-6 py-3 font-semibold text-white transition hover:bg-[#600000]"
                  >
                    Watch Inkspace Workshop Recording
                  </a>
                </div>
              )}
{/* Google Meet Link
{item.googlemeetinglink && (
  <div class="pt-3">
    <a
      href={item.googlemeetinglink.trim()}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block rounded-lg bg-[#38a169] px-6 py-3 font-semibold text-white transition hover:bg-[#2f855a]"
    >
      Join via Google Meet
    </a>
  </div>
)} */}

{/* YouTube Live Link */}
{item.Youtubelivelink && (
  <div class="pt-3">
    <a
      href={item.Youtubelivelink.trim()}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block rounded-lg bg-[#800000] px-6 py-3 font-semibold text-white transition hover:bg-[#600000]"
    >
      Watch Synfig Studio Workshop Recording
    </a>
  </div>
)}
            </div>
          </details>
        ))}
      </div>

      <!-- Note Section -->
      <div class="mt-8 rounded-lg border border-gray-200 bg-[#dde9af] p-4 text-center text-lg italic text-gray-600">
        <p class="text-xl">
          <strong class="text-xl text-red-600">Note:</strong>
          Workshop and webinar dates, registration details, and joining links
          will be announced on this page.
        </p>
      </div>

    </div>
  </section>

  <style>
    .custom-register-btn {
      display: inline-block;
      border-radius: 0.375rem;
      background-color: #38a169;
      padding: 0.625rem 2rem;
      font-size: 1.25rem;
      font-weight: 700;
      color: #ffffff;
      text-decoration: none;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
                  0 2px 4px -1px rgba(0, 0, 0, 0.06);
      transition: all 0.2s ease-in-out;
      cursor: pointer;
    }

    @media (hover: hover) {
      .custom-register-btn:hover {
        background-color: #2f855a;
        transform: scale(1.05);
      }
    }

    .custom-register-btn:active {
      background-color: #2f855a;
      transform: scale(0.95);
    }
  </style>
</Main>
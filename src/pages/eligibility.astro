---
import Main from '../layouts/main.astro';
import eligibility from '../images/eligibility.png';
import { slide } from 'astro:transitions';
---

<Main>
  <section id="eligibility" class="bg-white py-12">
    <div class="mx-auto max-w-6xl px-6">
      
      <!-- Top Section: Centered Heading -->
      <div class="mb-8 w-full text-center">
        <h2 class="text-3xl font-bold text-[#800000ff]">
          Eligibility to Participate
        </h2>
      </div>

      <!-- Content Card -->
      <div class="mt-4 text-xl rounded-xl border border-green-300 bg-white p-6 shadow-sm">
        <ul class="space-y-4 text-gray-700">
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>The hackathon is open to all.</span>
          </li>
          
          <!-- <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>Participate as an individual or as a team (max. 4 members).</span>
          </li> -->
          
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>High school/college students, faculty, and professionals (animators, designers, etc.) from any field who are interested in creating animations.</span>
          </li>
          
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>Knowledge of basic graphics, designing, and animation is required.</span>
          </li>
          
          <li class="flex items-start gap-3">
            <span class="text-[#800000ff]">•</span>
            <span>
              Prior knowledge of using Synfig Studio to create 2D animation is expected. If you are self-motivated and want to participate, you can learn Synfig Studio using 
              <a 
                href="https://spoken-tutorial.org" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-medium text-blue-600 hover:underline"
              >
                Spoken Tutorials
              </a>. 
              These are available in English, Hindi, Kannada, Marathi, Malayalam, Tamil, and Telugu.
            </span>
          </li>
        </ul>
      </div>

    </div>
  </section>
  <section id="eligibility" class="bg-white py-12">
    <div class="mx-auto max-w-6xl px-6">
  <!-- Top Grid: Heading & Image -->
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div>
         <h2 class="text-3xl font-bold text-center text-[#800000ff] mb-8">
            Who Can Participate?
          </h2>
          <p class="mt-2 text-xl text-center text-gray-600">
            Open to creators, thinkers, and animators across all skill levels.
          </p>
        </div>
        
        <div class="flex justify-center md:justify-end">
          <img 
            src={eligibility.src} 
            alt="Welcome to Synfig Studio Hackathon" 
            decoding="async"
            class="max-h-64 w-auto object-contain"
            transition:animate={slide({ duration: '0.6s' })} 
          />
        </div>
      </div>

      <!-- Eligibility Highlights Grid -->
      <div class="mt-4 grid gap-6 sm:grid-cols-3">
        
        <!-- Entry Fee -->
        <div class="flex items-start gap-4 rounded-xl border border-green-300 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-xl text-[#800000]">
            🏷️
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">No Entry Fee</h3>
            <p class="mt-1 text-xl text-gray-600">
              Participation in ANIMATE 2026 is completely free of charge.
            </p>
          </div>
        </div>

        <!-- Target Audience -->
        <div class="flex items-start gap-4 rounded-xl border border-green-300 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-xl text-[#800000]">
            🎓
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Open to All</h3>
            <p class="mt-1 text-xl text-gray-600">
              Students, freelancers, working professionals, and animation enthusiasts.
            </p>
          </div>
        </div>

        <!-- Team Structure -->
        <div class="flex items-start gap-4 rounded-xl border border-green-300 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-50 text-xl text-[#800000]">
            👥
          </div>
          <div>
            <h3 class="font-semibold text-gray-900">Solo or Teams</h3>
            <p class="mt-1 text-xl text-gray-600">
              Participate individually or assemble a team of up to 4 members.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>
</Main>
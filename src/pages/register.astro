---
import Main from '../layouts/main.astro';
import qrcode from '../images/qrcode.png';
---

<Main>
  <section id="register" class="py-10 px-4">
    <div
      class="mx-auto max-w-7xl rounded-xl border border-green-300 bg-white p-6 shadow-sm md:p-8"
    >
      <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-4">

        <!-- Left Side: QR Code and Registration -->
        <div
          class="flex flex-col items-center justify-center rounded-lg bg-[#fff7f7] p-5 text-center md:col-span-1"
        >
          <div class="mt-6 mb-5 flex justify-center">
  <a
    href="https://docs.google.com/forms/d/e/1FAIpQLSfOoeKC0rqosNRICXMyxRFqpHF3fLVmpS2kqTqJwNLc5U-cog/viewform"
    target="_blank"
    rel="noopener noreferrer"
    class="custom-register-btn"
  >
    Register
  </a>
</div>
<style>
  .custom-register-btn {
    display: inline-block;
    border-radius: 0.375rem;
    background-color: #38a169;
    padding: 0.625rem 2rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transition: all 0.2s ease-in-out;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    cursor: pointer;
  }

  /* Desktop hover effect */
  @media (hover: hover) {
    .custom-register-btn:hover {
      background-color: #2f855a;
      transform: scale(1.05);
    }
  }

  /* Mobile tap and click effect */
  .custom-register-btn:active {
    background-color: #2f855a;
    transform: scale(0.95);
  }
</style>

          <p class="mb-4 text-xl font-medium text-gray-700">
            Scan the QR code to register or click the Register button above.
          </p>

          <img
            src={qrcode.src}
            alt="ANIMATE 2025 Registration QR Code"
            class="mx-auto w-full max-w-[250px] rounded-md"
            decoding="async"
          />
        </div>

        <!-- Right Side: Registration Instructions -->
        <div class="md:col-span-3">
         <h2 class="text-3xl font-bold text-[#800000ff] sm:text-3xl">
            Read Before Registration
          </h2>
<br>
          <ul class="list-disc space-y-4 pl-6 text-xl leading-relaxed text-gray-800 md:text-lg">
  <li>
    Participate as an individual or as a team (maximum 4 members).
  </li>

  <li>
    Ideally, a team can consist of individuals with different skills, such as
    Synfig Studio users, animators, graphic designers, story narrators,
    video editors, etc.
  </li>

  <li>
    Use <strong>ONLY open-source software</strong> for creating animations.
    <span class="text-[#800000ff] text-bold-600">
      You are not allowed to use any proprietary software for any aspect of
      your animation. If found, you and your team will be disqualified.
    </span>
  </li>

  <li>
    <div class="mb-2">Submissions will be accepted in 3 categories:</div>

    <ol class="list-decimal space-y-2 pl-6">
      <li>Under 18 - Junior Animation Mavericks</li>
      <li>College Students - College Creators</li>
      <li>Working Professionals - Professional Prodigies</li>
    </ol>
  </li>
</ul>   

      </div>
    </div>
  </section>
</Main>